# ============================================================
# VYUGAM 2.0 ENTRY SCANNER - ENVIRONMENT CONFIGURATION
# ============================================================

# Supabase Public API URL (Vercel & Client safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Vercel & Client safe)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE IN CLIENT/VITE)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Default Event Identifier
VITE_DEFAULT_EVENT_ID=VYUGAM-2026
